# Copie este arquivo para .env e ajuste os valores.

# String de conexão do PostgreSQL (Neon, Render, local…)
# Neon costuma vir com ?sslmode=require — o app normaliza para verify-full
# automaticamente e elimina o SECURITY WARNING do driver pg.
# Use placeholders aqui. A credencial real vive só no painel do provedor
# (Railway/Neon/etc.) ou num .env local fora do controle de versão.
DATABASE_URL=postgres://USUARIO:SENHA@HOST:5432/NOME_DO_BANCO

# true em serviços gerenciados que exigem SSL (Render, Neon, Heroku, etc.)
# Pode ficar false se a própria DATABASE_URL já trouxer sslmode=.
DATABASE_SSL=false

# Só use false se o provedor tiver certificado que o Node não confia
# (raro no Neon free). Em produção o padrão é validar o certificado.
# DATABASE_SSL_REJECT_UNAUTHORIZED=false

# Tamanho do pool e timeout de conexão (opcional)
# Padrão: PG_POOL_MAX=10. No teste de carga com 70 mesas simultâneas,
# PG_POOL_MAX=20 NÃO melhorou o throughput (o gargalo era CPU/commit, não o
# pool). Aumente apenas com evidência de espera por conexão (pg_stat_activity)
# e folga real de conexões no provedor.
# PG_POOL_MAX=10
# PG_CONNECT_TIMEOUT_MS=10000
# Tetos anti-travamento (ms): nenhuma consulta/transação pode segurar lock
# nem conexão para sempre no pico.
# PG_STATEMENT_TIMEOUT_MS=30000
# PG_LOCK_TIMEOUT_MS=15000
# PG_IDLE_TX_TIMEOUT_MS=30000
# Coalescência dos avisos SSE públicos (mesa/garçom): no máximo 1 aviso por
# janela por cliente; 0 desliga. Staff recebe sempre tudo na hora.
# SSE_PUBLIC_COALESCE_MS=300

PORT=3000

# Senha de BOOTSTRAP dos usuários admin/cozinha/bar/caixa.
# Obrigatória no primeiro start em produção; o servidor recusa subir sem ela.
# Regras aplicadas pelo backend (db/auth.js::garantirStaffSeed):
#   - mínimo de 12 caracteres (valor menor => HTTP 503, não cria usuário);
#   - usada UMA vez, só quando a tabela staff está vazia;
#   - as contas nascem com deve_trocar_senha=TRUE (troca obrigatória no 1º login).
# Gere um valor único e guarde no gerenciador de senhas do estabelecimento.
# NUNCA versione a senha real: este arquivo é apenas o modelo.
#   node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
STAFF_SEED_PASSWORD=

# Alias legado aceito apenas se STAFF_SEED_PASSWORD estiver vazio.
# ADMIN_PASSWORD=

# PIX estático (QR / copia-e-cola na mesa e no caixa)
# Chave: CPF (11 dígitos), CNPJ, e-mail, telefone (+5511...) ou chave aleatória
# Exemplos:
#   PIX_CHAVE=12345678901
#   PIX_CHAVE=123.456.789-01   (também funciona — normalizamos)
#   PIX_CHAVE=seu@email.com
#   PIX_CHAVE=+5511999999999
PIX_CHAVE=
PIX_NOME=LANCHONETE
PIX_CIDADE=SAO PAULO

# NODE_ENV=production

# Fuso do estabelecimento (dashboard / relatórios)
APP_TIMEZONE=America/Sao_Paulo

# Só configurar depois de confirmar a topologia e o comportamento do proxy.
# Sem confirmação, mantém 0 e ignora X-Forwarded-For (mais seguro).
# TRUSTED_PROXY_HOPS=1
# Railway documenta X-Real-IP como o IP do cliente. Habilite só após validar (docs/engineering/rate-limit-and-proxy.md, issue #50):
# CLIENT_IP_HEADER=x-real-ip

# Troca obrigatória de senha para contas com senha inicial/compartilhada (#55).
# Padrão: ligada em NODE_ENV=production, desligada nos demais. Use true/false para forçar.
# STAFF_FORCE_PASSWORD_CHANGE=true
